# ===== Copia este archivo como .env y rellena tus valores =====
# (NUNCA subas el .env real a GitHub: ya está en .gitignore)

# --- Base de datos PostgreSQL ---
# Local con Docker:  postgresql://botuser:botpass123@postgres:5432/innovventas_bot
# Neon (producción): pega aquí la "Connection string" de tu proyecto Neon
DATABASE_URL=

# --- LLM (Groq, capa gratuita) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- CORS: dominios que pueden llamar a la API ---
# En la demo puedes dejar *  |  En producción pon tu URL de Netlify:
# ALLOWED_ORIGINS=https://tu-sitio.netlify.app
ALLOWED_ORIGINS=*
